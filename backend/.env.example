# Copie para .env local e preencha os valores. Nunca versionar .env.
# Desenvolvimento local: o schema da aplicação é gft_inteligente.
DATABASE_URL="postgresql://postgres:YOUR_DATABASE_PASSWORD@db.example.supabase.co:5432/postgres?schema=gft_inteligente"
# Desenvolvimento/diagnóstico: conexão direta ou Session Pooler (porta 5432).
# Produção: prefira o Transaction Pooler do Supabase (porta 6543), com os parâmetros
# de URL connection_limit=10 e pool_timeout=5; não misture esses parâmetros com
# credenciais reais em arquivos versionados. O backend também aplica maxWait por
# transação via DATABASE_POOL_TIMEOUT_MS.
DATABASE_CA_CERT=
DATABASE_POOL_MAX=10
DATABASE_POOL_TIMEOUT_MS=5000
DATABASE_TRANSACTION_TIMEOUT_MS=15000
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_RETRY_MAX_ATTEMPTS=3
DATABASE_RETRY_BASE_DELAY_MS=100
DATABASE_RETRY_MAX_DELAY_MS=1000
PORT=3001
FRONTEND_ORIGIN="http://localhost:3000"
JWT_ACCESS_SECRET="SUBSTITUIR_POR_SEGREDO_ALEATORIO_DE_PELO_MENOS_32_CARACTERES"
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER="gft-inteligente-api"
JWT_AUDIENCE="gft-inteligente-client"
BCRYPT_COST=12
TERMS_VERSION="2026-10-01"
PRIVACY_POLICY_VERSION="2026-10-01"

# Opcional: somente a rota de insights precisa desta chave. Nunca usar prefixo NEXT_PUBLIC_ ou versionar a chave real.
GEMINI_API_KEY=
# Em HTTP 503 do modelo principal, o servidor tenta uma vez gemini-3.5-flash-lite.
GEMINI_MODEL="gemini-3.8-flash"

# Alertas: taxa de erro por rota (%), mínimo de amostras e p95 em milissegundos.
ALERT_ERROR_RATE_PERCENT=20
ALERT_MIN_ROUTE_REQUESTS=5
ALERT_LATENCY_P95_MS=1000
ALERT_AUTH_FAILURES_THRESHOLD=10
ALERT_RATE_LIMIT_THRESHOLD=5
ALERT_INTEGRATION_FAILURES_THRESHOLD=3
ALERT_WINDOW_SECONDS=300
ALERT_SILENCE_SECONDS=300
# Webhook opcional; permanece desligado mesmo que a URL esteja configurada.
ALERT_WEBHOOK_ENABLED=false
ALERT_WEBHOOK_URL=

# Proteção de integrações externas. O timeout de cada chamada fica abaixo do limite da requisição.
RECEITAWS_TIMEOUT_MS=4500
GEMINI_TIMEOUT_MS=7000
UPSTREAM_MAX_ATTEMPTS=2
UPSTREAM_RETRY_BASE_DELAY_MS=200
UPSTREAM_CIRCUIT_FAILURES=3
UPSTREAM_CIRCUIT_RECOVERY_MS=30000
