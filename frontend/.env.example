# URL do NestJS acessível pelo servidor Next. Inclua o prefixo /api/v1.
# Localmente, rode o Nest na porta 3001, pois o Next ocupa a porta 3000.
AUTH_API_BASE_URL=http://localhost:3001/api/v1

# Precisam coincidir com TERMS_VERSION e PRIVACY_POLICY_VERSION do NestJS.
TERMS_VERSION=2026-10-01
PRIVACY_POLICY_VERSION=2026-10-01

# Opcional: origem pública exata do front-end para validar Origin em POST.
# No Preview, use a origem HTTPS pública do site. Em desenvolvimento local:
APP_ORIGIN=http://localhost:3000

# Para HTTP local, defina false (SameSite=Lax). Em Preview/produção HTTPS,
# deixe true ou omita (padrão seguro: SameSite=None; Secure).
AUTH_COOKIE_SECURE=false
